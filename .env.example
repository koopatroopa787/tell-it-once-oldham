# Copy this file to .env and fill in your keys.

# Pathly's matcher (same provider as the chatbot).
DEEPSEEK_API_KEY=sk-...
MATCH_MODEL=deepseek-flash

# Only the Tell It Once modules (triage.py, eval_bias.py) use Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# The borough your council rep represents. Used across the app and in prompts.
BOROUGH=Oldham

# Use a faster model if the demo feels slow, e.g. claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_TOKENS=4000


# Websites allowed to call the API, comma separated. Set to the live site address once deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Voice chat (ElevenLabs Agents). Create the agent as described in web/README.md.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
