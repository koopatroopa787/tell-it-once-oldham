# Copy this file to .env and fill in the keys you actually use.
# Pathly: create this at https://platform.deepseek.com/ and never commit it.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MAX_TOKENS=1400
DEEPSEEK_TIMEOUT_SECONDS=15

# Optional: only the Tell It Once modules (triage.py, eval_bias.py) use Anthropic.
ANTHROPIC_API_KEY=

# The borough your council rep represents. Used across the app and in prompts.
BOROUGH=Oldham

# Legacy connector model only.
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_TOKENS=4000


# Websites allowed to call the API, comma separated. Set to the live site address once deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Voice: ElevenLabs reads results aloud and turns spoken answers into text. Leave blank for text only.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# Voice calls per visitor per 10 minutes, to protect your credits.
VOICE_LIMIT_PER_10_MIN=40
