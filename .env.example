# Copy this file to .env and fill in your key.
ANTHROPIC_API_KEY=sk-ant-...

# The borough your council rep represents. Used across the app and in prompts.
BOROUGH=Oldham

# Use a faster model if the demo feels slow, e.g. claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
MAX_TOKENS=4000


# Websites allowed to call the API, comma separated. Set to the live site address once deployed.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
